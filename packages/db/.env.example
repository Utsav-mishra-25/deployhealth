# Used by `pnpm db:migrate`, `pnpm db:seed` and drizzle-kit.
DATABASE_URL=postgres://deployhealth:deployhealth@localhost:5432/deployhealth
# Used by the Vitest suites. Tests drop and recreate this database's schema.
TEST_DATABASE_URL=postgres://deployhealth:deployhealth@localhost:5432/deployhealth_test

# Public URL of the web app. The demo seed points the failing "Acme API" endpoint at
# <DEMO_BASE_URL>/api/demo/broken (the web app serves it when DEMO_PUBLIC=1).
DEMO_BASE_URL=http://localhost:3000

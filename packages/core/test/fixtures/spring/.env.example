DATABASE_URL=
PAYMENTS_URL=
# Relaxed binding: Spring Boot's own prefixes.
SPRING_DATASOURCE_USERNAME=
SERVER_PORT=
# Relaxed binding: the env form of a key in application.yml (mail.host).
MAIL_HOST=
# Relaxed binding: cache.ttl-seconds (dashes are dropped, so not CACHE_TTL_SECONDS).
CACHE_TTLSECONDS=
# Relaxed binding: @ConfigurationProperties(prefix = "app.mail").
APP_MAIL_SENDER=
TARGET_TS=
TEST_ONLY_JVM=
# Only text inside a block scalar looks like this key: UNUSED.
NOTES_FAKE=
UNUSED_JVM=

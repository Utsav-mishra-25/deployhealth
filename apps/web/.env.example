# Postgres. `docker compose up -d` at the repo root gives you exactly this.
DATABASE_URL=postgres://deployhealth:deployhealth@localhost:5432/deployhealth

# Auth.js signing secret, at least 32 characters: `openssl rand -base64 32`
AUTH_SECRET=

# GitHub OAuth app (login only). Callback URL: <app url>/api/auth/callback/github
# Required in production; optional locally if you use the demo login.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# 1 shows "Continue as dev user" (signs in as a local dev account that can create and edit).
# Ignored when NODE_ENV=production: the provider is never registered there.
AUTH_DEMO_LOGIN=1

# 1 serves the read-only public demo at /demo, no sign-in needed, plus /api/demo/broken (always
# 503; the demo's failing endpoint). Shows the data from `pnpm db:seed`. 0 (the default) 404s both.
DEMO_PUBLIC=1

# Optional. Signs report share links (at least 32 characters: `openssl rand -base64 32`).
# When empty, a key is derived from AUTH_SECRET, so rotating AUTH_SECRET also invalidates every
# share link. Set this explicitly to rotate the two independently.
REPORT_SHARE_SECRET=

# Optional. Where to report vulnerabilities: shown on /security and in /.well-known/security.txt.
# When empty, both point at a private security advisory on the GitHub repository instead.
SECURITY_CONTACT_EMAIL=

# Optional. The GitHub App for pull request env checks (docs/github-app-manifest.json). Leave both
# empty to turn it off. GITHUB_APP_WEBHOOK_SECRET is the webhook secret you set on the App
# (`openssl rand -hex 32`); GITHUB_APP_SLUG is the name in its URL (github.com/apps/<slug>).
GITHUB_APP_WEBHOOK_SECRET=
GITHUB_APP_SLUG=

# This deployment's public origin, e.g. https://deployhealth.dev (scheme and host, optional port,
# no path). Every absolute URL (security.txt, the sitemap, canonical URLs, the Action snippet,
# share links) uses it, so a forged Host header can't change them. Set it in production; when
# empty or invalid, they follow the request's host (fine locally) and one error is logged at
# startup saying what's wrong (for an empty one, in production only).
# Not read by Auth.js: sign-in still follows the request's host.
PUBLIC_ORIGIN=

# Optional, for `pnpm e2e`: use an already-installed Chromium instead of `playwright install chromium`.
PLAYWRIGHT_CHROMIUM_PATH=

# Optional. Sentry error reporting, server side only (https://sentry.io → project → Client Keys
# (DSN)). Empty: off. Reports are scrubbed before they leave the server: no request bodies,
# headers, cookies, query strings, tokens, webhook URLs or env values (packages/db/src/redact.ts).
SENTRY_DSN=
# Set by Railway on every deploy (the commit being deployed); tags Sentry reports with it. Don't set it.
RAILWAY_GIT_COMMIT_SHA=

# Optional. A public status page (e.g. Better Stack's), https only: the footer links to it as
# "Status". Empty: no link. An invalid value hides the link and logs one error at startup.
STATUS_PAGE_URL=

{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pnpm --filter @deployhealth/web... build",
    "watchPatterns": ["/apps/web/**", "/packages/**", "/package.json", "/pnpm-lock.yaml", "/pnpm-workspace.yaml", "/tsconfig.base.json", "/.nvmrc"]
  },
  "deploy": {
    "preDeployCommand": ["node packages/db/dist/migrate.js"],
    "startCommand": "pnpm --filter @deployhealth/web start",
    "healthcheckPath": "/api/health",
    "restartPolicyType": "ON_FAILURE"
  }
}

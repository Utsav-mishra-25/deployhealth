{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pnpm --filter @deployhealth/worker... build",
    "watchPatterns": ["apps/worker/**", "packages/**", "pnpm-lock.yaml"]
  },
  "deploy": {
    "startCommand": "pnpm --filter @deployhealth/worker start",
    "restartPolicyType": "ALWAYS"
  }
}

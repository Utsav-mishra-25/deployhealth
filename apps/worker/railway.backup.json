{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "apps/worker/backup.Dockerfile",
    "watchPatterns": ["/apps/worker/**", "/packages/**", "/package.json", "/pnpm-lock.yaml", "/pnpm-workspace.yaml", "/tsconfig.base.json", "/.nvmrc", "/.dockerignore"]
  },
  "deploy": {
    "startCommand": "node apps/worker/dist/backup.js",
    "cronSchedule": "41 3 * * *",
    "restartPolicyType": "NEVER"
  }
}

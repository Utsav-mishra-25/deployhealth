# Same database as the web app; pg-boss keeps its queue tables in the `pgboss` schema.
DATABASE_URL=postgres://deployhealth:deployhealth@localhost:5432/deployhealth

# 1 keeps the public demo (served by the web app at /demo) in its seed state: the reseed-demo job
# runs nightly and once on start. Needs DEMO_BASE_URL. Use the same value as the web app's.
DEMO_PUBLIC=0
# The web app's public URL, e.g. https://web-production-1234.up.railway.app. The demo's failing
# "Acme API" endpoint is <DEMO_BASE_URL>/api/demo/broken. (Locally it's http://localhost:3000; the
# SSRF guard blocks the worker from checking it, and the seeded failures keep the alert open.)
DEMO_BASE_URL=http://localhost:3000

# The GitHub App that runs pull request env checks (docs/github-app-manifest.json). Leave both
# empty to turn the checks off. GITHUB_APP_ID is the App's numeric id; GITHUB_APP_PRIVATE_KEY is the
# .pem GitHub generated, base64-encoded on one line (`base64 -w0 key.pem`). Never commit it.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=

# Optional. Sentry error reporting (https://sentry.io → project → Client Keys (DSN)). Empty: off.
# Reports are scrubbed before they leave the process: no request data, cookies, headers, tokens,
# webhook URLs or env values (packages/db/src/redact.ts).
SENTRY_DSN=
# Set by Railway on every deploy (the commit being deployed); tags Sentry reports with it. Don't set it.
RAILWAY_GIT_COMMIT_SHA=

# Optional. A Slack (or Discord, with /slack appended) incoming webhook for operator alerts: the
# check-endpoints heartbeat went stale, or a job failed 3 times in a row. Rate-limited. Empty: off.
OPERATOR_WEBHOOK_URL=
